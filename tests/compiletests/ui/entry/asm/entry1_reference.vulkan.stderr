               OpCapability Shader
               OpCapability FloatControls2
               OpCapability DenormPreserve
               OpCapability RoundingModeRTE
               OpExtension "SPV_KHR_float_controls2"
               OpExtension "SPV_KHR_float_controls"
               OpMemoryModel Logical Simple
               OpEntryPoint Vertex %1 "main" %input %output
               OpExecutionModeId %1 FPFastMathDefault %f32 %u32_0
               OpExecutionMode %1 DenormPreserve 32
               OpExecutionMode %1 RoundingModeRTE 32
               OpName %input "input"
               OpName %output "output"
               OpDecorate %input Location 0
               OpDecorate %output Location 0
        %f32 = OpTypeFloat 32
      %v4f32 = OpTypeVector %f32 4
%_ptr_Input_v4f32 = OpTypePointer Input %v4f32
%_ptr_Output_v4f32 = OpTypePointer Output %v4f32
       %void = OpTypeVoid
         %13 = OpTypeFunction %void
      %input = OpVariable %_ptr_Input_v4f32 Input
      %f32_1 = OpConstant %f32 1
     %output = OpVariable %_ptr_Output_v4f32 Output
        %u32 = OpTypeInt 32 0
      %u32_0 = OpConstant %u32 0
          %1 = OpFunction %void None %13
         %16 = OpLabel
         %17 = OpLoad %v4f32 %input
         %18 = OpCompositeConstruct %v4f32 %f32_1 %f32_1 %f32_1 %f32_1
         %19 = OpFAdd %v4f32 %17 %18
               OpStore %output %19
               OpNoLine
               OpReturn
               OpFunctionEnd
