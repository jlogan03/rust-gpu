               OpCapability Shader
               OpCapability DenormFlushToZero
               OpCapability SignedZeroInfNanPreserve
               OpCapability RoundingModeRTZ
               OpCapability VulkanMemoryModel
               OpMemoryModel Logical Vulkan
               OpEntryPoint GLCompute %1 "manual"
               OpExecutionMode %1 LocalSize 1 1 1
               OpExecutionMode %1 DenormFlushToZero 64
               OpExecutionMode %1 SignedZeroInfNanPreserve 64
               OpExecutionMode %1 RoundingModeRTZ 64
               OpName %manual_execution_modes__manual "manual_execution_modes::manual"
       %void = OpTypeVoid
          %5 = OpTypeFunction %void
