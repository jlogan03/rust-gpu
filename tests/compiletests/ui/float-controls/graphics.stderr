               OpCapability Shader
               OpCapability VulkanMemoryModel
               OpCapability FloatControls2
               OpCapability DenormFlushToZero
               OpCapability RoundingModeRTE
               OpExtension "SPV_KHR_float_controls2"
               OpExtension "SPV_KHR_float_controls"
               OpMemoryModel Logical Vulkan
               OpEntryPoint Fragment %1 "fast" %output
               OpExecutionMode %1 OriginUpperLeft
               OpExecutionModeId %1 FPFastMathDefault %f32 %u32_458764
               OpExecutionMode %1 DenormFlushToZero 32
               OpExecutionMode %1 RoundingModeRTE 32
               OpName %output "output"
               OpDecorate %output Location 0
        %f32 = OpTypeFloat 32
%_ptr_Output_f32 = OpTypePointer Output %f32
       %void = OpTypeVoid
          %8 = OpTypeFunction %void
        %u32 = OpTypeInt 32 0
 %u32_458764 = OpConstant %u32 458764
     %output = OpVariable %_ptr_Output_f32 Output
      %f32_0 = OpConstant %f32 0
