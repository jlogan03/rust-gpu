               OpCapability Shader
               OpCapability Float64
               OpCapability FloatControls2
               OpCapability DenormPreserve
               OpCapability RoundingModeRTE
               OpExtension "SPV_KHR_float_controls2"
               OpExtension "SPV_KHR_float_controls"
               OpMemoryModel Logical Simple
               OpEntryPoint Fragment %1 "main" %output
               OpExecutionMode %1 OriginUpperLeft
               OpExecutionModeId %1 FPFastMathDefault %f64 %u32_0
               OpExecutionMode %1 DenormPreserve 64
               OpExecutionMode %1 RoundingModeRTE 64
          %5 = OpString "$DIR/const-float-cast-optimized.rs"
               OpName %output "output"
               OpDecorate %output Location 0
        %f64 = OpTypeFloat 64
%_ptr_Output_f64 = OpTypePointer Output %f64
       %void = OpTypeVoid
          %8 = OpTypeFunction %void
     %output = OpVariable %_ptr_Output_f64 Output
   %f64_20_5 = OpConstant %f64 20.5
        %u32 = OpTypeInt 32 0
      %u32_0 = OpConstant %u32 0
